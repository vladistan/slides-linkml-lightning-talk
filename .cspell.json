{
  "allowCompoundWords": true,
  "caseSensitive": false,
  "dictionaries": [
    "typescript",
    "node",
    "npm",
    "html",
    "css"
  ],
  "ignorePaths": [
    "**/.git/**",
    ".*",
    "**/.gitleaksignore",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.log",
    "**/package-lock.json",
    "**/*.svg",
    "**/*.min.js",
    "slides-png/**",
    "slides.html"
