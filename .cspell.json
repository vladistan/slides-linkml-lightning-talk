  "language": "en",
  "noConfigSearch": true,
  "version": "0.2",
  "words": [
    "LinkML",
    "linkml",
    "SHACL",
    "Pydantic",
    "pydantic",
    "MIxS",
    "BioLink",
    "Monarch",
    "risograph",
    "Marp",
    "marp",
    "Asciinema",
    "asciinema",
    "pngs",
    "qrcode",
    "toml",
    "DDL",
    "Protobuf",
    "GraphDB",
    "tomllib",
    "ISMB",
    "fanout",
    "vladistan",
    "datadict",
    "capsys",
    "sqlddl"
  ]
